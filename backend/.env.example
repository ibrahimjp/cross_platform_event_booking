PORT=3000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/eventbook?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=
CLIENT_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me
CLOUDINARY_CLOUD_NAME=replace_me
PUBLIC_URL=http://localhost:3000
# Set to 1 when deployed behind a proxy such as Render.
TRUST_PROXY=0
# Optional: creates (or promotes) this admin on startup. Or run `npm run create-admin`.
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin@1
# Demo-only: book tickets without charging a card.
ALLOW_TEST_PAYMENTS=false
